{
  "$comment": "Path-traversal fixtures locking the §4.6 security rule: resource_prefixes are zone-internal absolute paths; '..' components, dot components, cross-zone prefixes and ambiguous encodings are rejected at the schema layer via the vendored zone-path projection (forbidden components '.' and '..').",
  "cases": [
    {
      "name": "grant-prefix-dotdot-rejected",
      "schema": "auth/v1/zone-grant.schema.json",
      "expect": "invalid",
      "payload": {
        "api_version": "auth.sudo.dev/v1",
        "kind": "ZoneGrant",
        "grant_id": "g",
        "zone_id": "cloud-user-1001",
        "grantee": { "subject_type": "user", "subject_id": "u" },
        "capabilities": ["zone.data.read"],
        "resource_prefixes": ["/sessions/../secrets"],
        "issued_by": { "subject_type": "user", "subject_id": "u" },
        "reason": "r",
        "policy_version": "p",
        "revision": "r",
        "status": "active",
        "created_at": "2026-09-18T08:00:00Z"
      }
    },
    {
      "name": "grant-prefix-dot-component-rejected",
      "schema": "auth/v1/zone-grant.schema.json",
      "expect": "invalid",
      "payload": {
        "api_version": "auth.sudo.dev/v1",
        "kind": "ZoneGrant",
        "grant_id": "g",
        "zone_id": "cloud-user-1001",
        "grantee": { "subject_type": "user", "subject_id": "u" },
        "capabilities": ["zone.data.read"],
        "resource_prefixes": ["./sessions"],
        "issued_by": { "subject_type": "user", "subject_id": "u" },
        "reason": "r",
        "policy_version": "p",
        "revision": "r",
        "status": "active",
        "created_at": "2026-09-18T08:00:00Z"
      },
      "$comment": "Also covers the relative-path form: prefixes are absolute by contract."
    },
    {
      "name": "resource-ref-path-dotdot-rejected",
      "schema": "common/v1/resource-ref.schema.json",
      "expect": "invalid",
      "payload": {
        "api_version": "common.sudo.dev/v1",
        "kind": "ResourceRef",
        "zone_id": "cloud-user-1001",
        "path": "/sessions/../../etc/passwd"
      }
    },
    {
      "name": "grant-prefix-no-leading-slash-rejected",
      "schema": "auth/v1/zone-grant.schema.json",
      "expect": "invalid",
      "payload": {
        "api_version": "auth.sudo.dev/v1",
        "kind": "ZoneGrant",
        "grant_id": "g",
        "zone_id": "cloud-user-1001",
        "grantee": { "subject_type": "user", "subject_id": "u" },
        "capabilities": ["zone.data.read"],
        "resource_prefixes": ["sessions"],
        "issued_by": { "subject_type": "user", "subject_id": "u" },
        "reason": "r",
        "policy_version": "p",
        "revision": "r",
        "status": "active",
        "created_at": "2026-09-18T08:00:00Z"
      }
    },
    {
      "name": "resource-ref-sys-path-rejected",
      "schema": "common/v1/resource-ref.schema.json",
      "expect": "invalid",
      "payload": {
        "api_version": "common.sudo.dev/v1",
        "kind": "ResourceRef",
        "zone_id": "cloud-user-1001",
        "path": "/__sys__/control"
      },
      "$comment": "The zone-path projection reserves __sys__ components."
    }
  ]
}
