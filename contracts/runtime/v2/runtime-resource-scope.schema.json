{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.sudo.dev/schemas/runtime/v2/runtime-resource-scope.schema.json",
  "title": "RuntimeResourceScope",
  "description": "Host-injected local runtime scope for defense in depth; it is not a credential.",
  "type": "object",
  "properties": {
    "schema_version": { "const": 1 },
    "zone_id": {
      "$ref": "https://nexus-vfs.dev/contracts/zone-id/existing-zone-id-ref.schema.gen.json"
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://contracts.sudo.dev/schemas/auth/v1/zone-delegation-scope-rule.schema.json"
      }
    }
  },
  "required": ["schema_version", "zone_id", "rules"],
  "additionalProperties": true
}
