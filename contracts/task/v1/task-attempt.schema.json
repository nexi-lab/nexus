{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.sudo.dev/schemas/task/v1/task-attempt.schema.json",
  "title": "TaskAttempt",
  "description": "P1b true Attempt record. execution_zone_id is immutable and PID replacement appends to pid_history without creating a new Attempt.",
  "type": "object",
  "properties": {
    "api_version": { "const": "task.sudo.dev/v1" },
    "kind": { "const": "TaskAttempt" },
    "attempt_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "session_id": { "type": "string", "minLength": 1 },
    "resolution_id": { "type": "string", "minLength": 1 },
    "execution_zone_id": {
      "$ref": "https://nexus-vfs.dev/contracts/zone-id/existing-zone-id-ref.schema.gen.json"
    },
    "state": {
      "enum": [
        "queued",
        "starting",
        "running",
        "awaiting_input",
        "output_ready",
        "verifying",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "pid_history": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "started_at": { "type": "string", "format": "date-time" },
    "ended_at": { "type": "string", "format": "date-time" },
    "failure": {
      "type": "object",
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "retryable": { "type": "boolean" }
      },
      "required": ["code", "message", "retryable"],
      "additionalProperties": true
    }
  },
  "required": [
    "api_version",
    "kind",
    "attempt_id",
    "task_id",
    "session_id",
    "resolution_id",
    "execution_zone_id",
    "state",
    "pid_history",
    "created_at"
  ],
  "additionalProperties": true
}
