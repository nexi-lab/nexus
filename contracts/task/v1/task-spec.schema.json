{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.sudo.dev/schemas/task/v1/task-spec.schema.json",
  "title": "TaskSpec",
  "description": "P1b implicit runtime task. The Nexus Session Runtime Service derives this write-once record from an authenticated runtime start; there is no public Task write API.",
  "type": "object",
  "properties": {
    "api_version": { "const": "task.sudo.dev/v1" },
    "kind": { "const": "TaskSpec" },
    "task_id": { "type": "string", "minLength": 1 },
    "session_id": { "type": "string", "minLength": 1 },
    "requested_by": {
      "$ref": "https://contracts.sudo.dev/schemas/common/v1/principal-ref.schema.json"
    },
    "input": {
      "type": "object",
      "properties": {
        "instruction": { "type": "string", "minLength": 1 },
        "resource_refs": {
          "type": "array",
          "items": {
            "$ref": "https://contracts.sudo.dev/schemas/common/v1/resource-ref.schema.json"
          }
        }
      },
      "required": ["instruction", "resource_refs"],
      "additionalProperties": false
    },
    "requested_mode": { "const": "auto" },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "required": [
    "api_version",
    "kind",
    "task_id",
    "session_id",
    "requested_by",
    "input",
    "requested_mode",
    "created_at"
  ],
  "additionalProperties": true
}
