# Nexus Cluster Binary — Slim Federation Runtime
#
# Kernel-tier Rust migrated to nexus-vfs (#4259). This Dockerfile
# installs the nexusd-cluster binary from the nexus-vfs git repo
# rather than building from local source.
#
# Build:
#   docker build -f dockerfiles/Dockerfile.nexusd-cluster -t nexusd-cluster:latest .
#
# Run:
#   docker run -e NEXUS_BIND_ADDR=0.0.0.0:2126 \
#     -e NEXUS_PEERS=node1:2126,node2:2126,witness:2126 \
#     -e NEXUS_BOOTSTRAP_NEW=1 \
#     -p 2126:2126 nexusd-cluster:latest

FROM rust:1-slim-bookworm AS builder

# protobuf-compiler: raft-proto uses protobuf-build which shells out
# to system protoc on PATH.
# python3: pyo3-build-config probes for an interpreter at compile time.
RUN apt-get update && apt-get install -y --no-install-recommends \
        protobuf-compiler \
        python3 \
        python3-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Pin nexus-vfs commit SHA — required for reproducible builds and to
# stop Docker layer caching from freezing a stale binary.  Without a
# pin, `cargo install --git` resolves to HEAD-of-default-branch at
# build time, but the cached layer reuses whatever HEAD was when the
# layer was first built — which silently regresses any fix landed
# upstream since.  Pinning makes the cargo install RUN line unique
# per SHA, so changing the pin invalidates the cache deterministically.
#
# Bump procedure: update NEXUS_VFS_REV to the latest nexus-vfs main
# commit you want to adopt.  Pin should always include #23 (ZoneManager
# async wrappers) and #25 (leader-detection SSOT) — both required for
# the L1 cross-machine federation read milestone to pass.
ARG NEXUS_VFS_REV=e90de894aa2f8457f4a894e7605fb0c587e288f7
RUN cargo install \
    --git https://github.com/nexi-lab/nexus-vfs \
    --rev "${NEXUS_VFS_REV}" \
    --bin nexusd-cluster \
    nexus-cluster

# ---------- Production image ----------
FROM debian:bookworm-slim

# bash: the compose healthcheck uses `bash -c '</dev/tcp/localhost/2126'`
# ca-certificates: outbound TLS for any remote backend driver calls
RUN apt-get update && \
    apt-get install -y --no-install-recommends bash ca-certificates && \
    rm -rf /var/lib/apt/lists/*

COPY --from=builder /usr/local/cargo/bin/nexusd-cluster /usr/local/bin/

# Non-root runtime user
RUN useradd -r -m -u 1000 -s /bin/bash nexus && \
    mkdir -p /app/data && \
    chown -R nexus:nexus /app

USER nexus
WORKDIR /app

ENV NEXUS_BIND_ADDR=0.0.0.0:2126 \
    NEXUS_DATA_DIR=/app/data \
    RUST_LOG=info,nexus_raft=debug

EXPOSE 2126

ENTRYPOINT ["nexusd-cluster"]
