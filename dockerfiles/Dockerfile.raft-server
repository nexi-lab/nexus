# Nexus Raft Server — Minimal Rust-Only Image
#
# Kernel-tier Rust migrated to nexus-vfs (#4259). This Dockerfile
# installs the nexus-raft-server binary from the nexus-vfs git repo.
#
# Usage:
#   docker build -f dockerfiles/Dockerfile.raft-server -t nexus-raft-server .
#
# Run:
#   docker run -e NEXUS_BIND_ADDR=0.0.0.0:2126 \
#     -e NEXUS_PEERS=node1:2126,node2:2126,node3:2126 \
#     -p 2126:2126 nexus-raft-server

FROM rust:1-slim-bookworm AS builder

# protobuf-compiler: raft-proto uses protobuf-build which shells out
# to system protoc on PATH.
RUN apt-get update && apt-get install -y --no-install-recommends \
        protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Pinned to the same nexus-vfs rev as every other kernel-tier image
# (CI preflight enforces agreement) — an unpinned install tracks HEAD
# and can skew the raft contract against the cluster/witness images.
# --locked honors the source tree's Cargo.lock.
ARG NEXUS_VFS_REV=1eb776c1fd61433f62d0a9a0b4896dad5b8be343
RUN cargo install --locked --git https://github.com/nexi-lab/nexus-vfs --rev "${NEXUS_VFS_REV}" --bin nexus-raft-server raft

# ---------- Production image ----------
FROM debian:bookworm-slim

RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates && \
    rm -rf /var/lib/apt/lists/*

COPY --from=builder /usr/local/cargo/bin/nexus-raft-server /usr/local/bin/

# Create non-root user
RUN useradd -r -m -u 1000 -s /bin/bash nexus && \
    mkdir -p /home/nexus/data && \
    chown -R nexus:nexus /home/nexus

USER nexus

ENV NEXUS_BIND_ADDR=0.0.0.0:2126 \
    NEXUS_DATA_DIR=/home/nexus/data \
    RUST_LOG=info,nexus_raft=debug

EXPOSE 2126

ENTRYPOINT ["nexus-raft-server"]
