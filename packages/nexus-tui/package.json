{
  "name": "@nexus-ai-fs/tui",
  "version": "0.10.1",
  "description": "Terminal UI for native Nexus files, Search and HTTP requests",
  "type": "module",
  "bin": {
    "nexus-tui": "./bin/nexus-tui.cjs"
  },
  "imports": {
    "#nexus-api-client": "./src/api-client.ts"
  },
  "files": [
    "bin",
    "src",
    "bunfig.toml",
    "tsconfig.json",
    "scripts/patch-jsx-types.cjs",
    "README.md"
  ],
  "scripts": {
    "dev": "bun run --conditions=browser src/index.tsx",
    "start": "bun run --conditions=browser src/index.tsx",
    "test": "bun test",
    "test:package": "bun run scripts/test-package.ts",
    "pack": "bun run scripts/pack.ts",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist",
    "postinstall": "node scripts/patch-jsx-types.cjs"
  },
  "dependencies": {
    "@nexus-ai-fs/api-client": "file:../nexus-api-client",
    "@opentui/core": "0.1.96",
    "@opentui/solid": "0.1.96",
    "solid-js": "1.9.11"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "typescript": "^5.5.0"
  },
  "keywords": [
    "nexus",
    "tui",
    "terminal",
    "opentui"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nexi-lab/nexus",
    "directory": "packages/nexus-tui"
  }
}
