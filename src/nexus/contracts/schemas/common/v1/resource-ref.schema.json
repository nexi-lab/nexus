{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sudo:contracts:common:v1:resource-ref",
  "title": "ResourceRef",
  "description": "Provisional Nexus-owned Product resource locator using exact-pinned nexus-vfs ZoneId and ZonePath owner projections.",
  "type": "object",
  "required": [
    "api_version",
    "kind",
    "zone_id",
    "path"
  ],
  "properties": {
    "api_version": {
      "const": "common.sudo.dev/v1",
      "description": "ResourceRef family major discriminator."
    },
    "kind": {
      "const": "ResourceRef",
      "description": "Product object kind discriminator."
    },
    "zone_id": {
      "$ref": "urn:sudo:nexus-vfs:zone-id:v1",
      "description": "Portable lexical ZoneId existing-reference form from the exact-pinned nexus-vfs owner projection."
    },
    "path": {
      "$ref": "urn:sudo:nexus-vfs:zone-path:v1",
      "description": "Strict zone-relative ZonePath from the exact-pinned nexus-vfs owner projection."
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[!-~]+(?![\\s\\S])",
      "description": "Opaque owner-issued visible-ASCII resource revision selector. Absence means no revision pin; null and empty strings are invalid."
    },
    "digest": {
      "type": "string",
      "maxLength": 545,
      "pattern": "^[a-z][a-z0-9._+-]{0,31}:(?:[0-9a-f]{2}){1,256}(?![\\s\\S])",
      "allOf": [
        {
          "if": {
            "pattern": "^sha256:"
          },
          "then": {
            "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
          }
        },
        {
          "if": {
            "pattern": "^blake3:"
          },
          "then": {
            "pattern": "^blake3:[0-9a-f]{64}(?![\\s\\S])"
          }
        }
      ],
      "description": "Algorithm-qualified lowercase hexadecimal digest of the logical dereferenced bytes. sha256 and blake3 require 32-byte values. It is not inferred from content_id."
    },
    "media_type": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9!#$%&'*+.^_`|~-]{0,126}/[a-z0-9][a-z0-9!#$%&'*+.^_`|~-]{0,126}(?![\\s\\S])",
      "description": "Canonical lowercase media type without parameters for the logical dereferenced bytes."
    },
    "size_bytes": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)(?![\\s\\S])",
      "description": "Canonical non-negative decimal byte count. String encoding avoids cross-language integer loss; zero means empty and absence means unknown."
    }
  },
  "propertyNames": {
    "$ref": "#/$defs/safe_property_name"
  },
  "additionalProperties": {
    "$ref": "#/$defs/safe_extension_value_0"
  },
  "maxProperties": 32,
  "$defs": {
    "safe_property_name": {
      "allOf": [
        {
          "pattern": "^[a-z][a-z0-9_]{0,63}(?![\\s\\S])"
        },
        {
          "not": {
            "pattern": "(?:password|passwd|secret|token|api_?key|private_?key|credential)"
          }
        }
      ]
    },
    "safe_extension_value_0": {
      "type": [
        "null",
        "boolean",
        "string",
        "integer",
        "array",
        "object"
      ],
      "maxLength": 4096,
      "minimum": -9007199254740991,
      "maximum": 9007199254740991,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/safe_extension_value_1"
      },
      "maxProperties": 32,
      "propertyNames": {
        "$ref": "#/$defs/safe_property_name"
      },
      "additionalProperties": {
        "$ref": "#/$defs/safe_extension_value_1"
      }
    },
    "safe_extension_value_1": {
      "type": [
        "null",
        "boolean",
        "string",
        "integer",
        "array",
        "object"
      ],
      "maxLength": 4096,
      "minimum": -9007199254740991,
      "maximum": 9007199254740991,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/safe_extension_value_2"
      },
      "maxProperties": 32,
      "propertyNames": {
        "$ref": "#/$defs/safe_property_name"
      },
