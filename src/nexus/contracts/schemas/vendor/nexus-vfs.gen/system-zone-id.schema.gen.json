{
  "$id": "https://nexus-vfs.dev/contracts/zone-id/system-zone-id.schema.gen.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "maxLength": 63,
      "minLength": 3,
      "pattern": "^[abcdefghijklmnopqrstuvwxyz0123456789][abcdefghijklmnopqrstuvwxyz0123456789\\-]*[abcdefghijklmnopqrstuvwxyz0123456789]$",
      "type": "string"
    },
    {
      "enum": [
        "root",
        "__control__"
      ]
    }
  ],
  "description": "Zone id accepted only by trusted boot and control paths.",
  "title": "SystemZoneId"
}
